{
  "name": "sandbox-app-template",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "cd packages/web && bunx vite",
    "dev:desktop": "cd packages/desktop && bunx vite",
    "dev:mobile": "cd packages/mobile && bunx expo start --port $(bun --print \"require('../../__ports.cjs').mobile\")",
    "build": "turbo build",
    "build:web": "cd packages/web && bunx vite build",
    "start": "pm2 startOrRestart ecosystem.config.cjs --update-env",
    "start:server": "bun packages/web/src/server.ts",
    "stop": "pm2 delete web-app 2>/dev/null || true",
    "kill:port": "bun run internal:kill-port",
    "lint": "oxfmt --check . && oxlint -D correctness packages/web/src",
    "lint:fix": "oxfmt .",
    "typecheck": "turbo typecheck",
    "test": "bun test packages/web/src",
    "test:e2e": "cd packages/web && bunx playwright test",
    "size": "cd packages/web && node vite/check-bundle-size.mjs",
    "og": "cd packages/web && node vite/generate-og.mjs",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "db:push": "turbo db:push",
    "internal:kill-port": "lsof -t -i :$(bun --print \"require('./__ports.cjs').website\") | xargs kill -9"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "pm2": "^7.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@runablehq/runkit": "0.1.1",
    "@tursodatabase/api": "^1.9.2",
    "@types/bun": "1.3.14",
    "oxfmt": "0.54.0",
    "oxlint": "^1.93.0",
    "turbo": "2.9.18",
    "typescript": "7.0.1-rc"
  },
  "packageManager": "bun@1.3.14"
}
