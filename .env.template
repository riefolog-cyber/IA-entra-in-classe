# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000

# Gateway Configuration (optional: AI profile analysis, opt-in in UI)
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_PROFILE_MODEL=openai/gpt-4.1-mini

# Limiti analisi IA (richieste al minuto; 0 = nessun limite).
# Valori ampi: servono a fermare gli abusi, non a interrompere il lavoro.
AI_ANALYSIS_RATE_LIMIT=20
AI_ANALYSIS_RATE_LIMIT_GLOBAL=120
