# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000

# Gateway Configuration (optional: AI profile analysis, opt-in in UI)
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_PROFILE_MODEL=openai/gpt-4.1-mini

# Modello della prima fase (una lettura per tappa). Vuoto = stesso modello.
# Un modello più economico qui riduce il costo senza abbassare la sintesi.
AI_PROFILE_MAP_MODEL=

# Lettura in due fasi (mappa delle tappe + sintesi). 0 = una sola chiamata.
AI_ANALYSIS_TWO_PHASE=1

# Limiti analisi IA (richieste al minuto; 0 = nessun limite).
# Valori ampi: servono a fermare gli abusi, non a interrompere il lavoro.
AI_ANALYSIS_RATE_LIMIT=20
AI_ANALYSIS_RATE_LIMIT_GLOBAL=120

# Budget giornaliero di analisi IA (0 = nessun limite).
AI_ANALYSIS_DAILY_LIMIT=500

# Origini fidate in più rispetto a quella del sito (separate da virgola).
# Di norma vuoto: le richieste cross-origin vengono rifiutate.
AI_ALLOWED_ORIGINS=
